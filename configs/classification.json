{
  "data_path": "nba_draft_data_collection/data/processed/two_stage_college_comparison.parquet",
  "target": "drafted",
  "numerical_features": [
    "college_age_on_july_1",
    "college_last_minutes",
    "college_last_points_per_40",
    "college_last_rebounds_per_40",
    "college_last_assists_per_40",
    "college_last_stocks_per_40_advanced",
    "college_last_ts_pct",
    "college_last_three_pct_shrunk",
    "college_career_seasons",
    "college_career_minutes",
    "college_career_points_per_40",
    "college_career_assists_per_40",
    "college_career_ts_pct",
    "college_career_three_pct_shrunk",
    "college_development_points_per_40_delta"
  ],
  "categorical_features": ["college_position"],
  "group_column": "nba_player_id",
  "split": {
    "column": "draft_year",
    "train_end": 2017,
    "validation_start": 2018,
    "validation_end": 2019,
    "test_start": 2020,
    "test_end": 2022
  },
  "model": {
    "name": "xgboost",
    "hyperparameters": {
      "objective": "binary:logistic",
      "eval_metric": "logloss",
      "tree_method": "hist",
      "random_state": 42,
      "n_jobs": -1,
      "n_estimators": 250,
      "learning_rate": 0.03,
      "max_depth": 2,
      "min_child_weight": 10,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_alpha": 1.0,
      "reg_lambda": 10.0
    }
  },
  "tuning": {
    "n_iter": 12,
    "random_state": 42,
    "metric": "average_precision",
    "search_space": {
      "n_estimators": [150, 250, 400],
      "learning_rate": [0.02, 0.03, 0.05],
      "max_depth": [2, 3],
      "min_child_weight": [5, 10],
      "subsample": [0.8, 1.0],
      "colsample_bytree": [0.8, 1.0]
    },
    "output_model_path": "models/classifier_tuned.joblib",
    "results_path": "models/classifier_tuning_results.json",
    "best_config_path": "configs/classification_best.json"
  },
  "output_model_path": "models/classifier.joblib",
  "report_path": "models/classifier_metrics.json"
}
